{
  "version": 2,
  "builds": [
    {
      "src": "frontend/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|svg|png|jpg|jpeg|json|woff2?|ttf|eot|webp))",
      "dest": "frontend/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/frontend/index.html"
    }
  ]
}
